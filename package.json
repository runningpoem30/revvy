{
  "name": "revenueguard-ai",
  "version": "1.0.0",
  "description": "AI Revenue Recovery Agent — Razorpay Buildathon 2026",
  "private": true,
  "workspaces": [
    "packages/agent",
    "packages/dashboard"
  ],
  "scripts": {
    "agent": "npm run dev --workspace=packages/agent",
    "dashboard": "npm run dev --workspace=packages/dashboard",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "setup": "npm install && npx prisma generate && npx prisma db push"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
